APP_NAME=KawinAPI
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-api.up.railway.app

# Generar con: php artisan key:generate --show
APP_KEY=

# ── Base de datos (Railway Postgres separado) ──────────────────────────────────
# En Railway: usa las variables que inyecta el plugin de Postgres
# o conéctate a la instancia externa con las vars individuales.
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# ── Cache y Queue ──────────────────────────────────────────────────────────────
# Para QA simple: file/sync. Para QA con workers: redis
CACHE_DRIVER=file
QUEUE_CONNECTION=sync

# Si usas Redis (Railway Redis plugin):
# CACHE_DRIVER=redis
# QUEUE_CONNECTION=redis
# REDIS_HOST=
# REDIS_PORT=6379
# REDIS_PASSWORD=

# ── Mail ───────────────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@kawin.app
MAIL_FROM_NAME="Kawin QA"

# ── API interna ────────────────────────────────────────────────────────────────
API_SECRET=

# ── WebSockets / Push (opcional en QA) ───────────────────────────────────────
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@kawin.app
